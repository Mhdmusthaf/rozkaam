# Copy this file to .env and fill in real values. Never commit .env.

# Leave empty to use the built-in local database (stored in ./.data).
DATABASE_URL=

# A long random string. Signs login tokens. Change it for any hosted server.
JWT_SECRET=dev-only-secret-change-me-please-32chars

PORT=4000

# sandbox = a fixed code is accepted and no SMS is sent.
SMS_PROVIDER=sandbox
SANDBOX_OTP=123456

# Phone numbers (10 digits, comma separated) allowed to sign in as admin.
ADMIN_PHONES=9847000001
